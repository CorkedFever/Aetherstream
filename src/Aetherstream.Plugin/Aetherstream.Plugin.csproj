<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.2.12.0</Version>
    <Authors>CorkedFever</Authors>
    <Description>Live streams on a screen anchored in the world.</Description>
    <AssemblyName>Aetherstream</AssemblyName>
    <RootNamespace>Aetherstream.Plugin</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- For the one place the plugin reads game memory: the live weather, through ClientStructs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Aetherstream.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Dalamud shows images\icon.png in the installer for an installed plugin; the repo manifest
         points at the same file on GitHub for the listing. -->
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- The test card: raw 1280x720 RGBA, gzipped. Rendered at build time from the site's palette. -->
    <None Include="images\testcard.rgba.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- The guide channel's face: VT323 rasterised to an alpha atlas at build time. -->
    <None Include="images\guidefont.a8.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- The fishing channel's windows: the Carbuncle Plushy tracker's data (MIT), trimmed by tools\make_fishdata.py. -->
    <None Include="data\fish.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- The story hour's Scions: their renders pixelated by tools\make_scions.py. -->
    <None Include="data\scions.json.gz" CopyToOutputDirectory="PreserveNewest" />
    <!-- VT323, SIL Open Font License. The licence ships beside it, as the OFL requires. -->
    <None Include="Fonts\VT323-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled lounge music for the drawn channels, with its credits. Royalty-free, attributed. -->
    <None Include="music\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aetherstream.Core\Aetherstream.Core.csproj" />
    <ProjectReference Include="..\Aetherstream.Playback\Aetherstream.Playback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The libvlc natives land in libvlc\win-x64 beside the assembly; Core.Initialize is pointed
         at that folder explicitly, since a plugin's base directory is the game's, not ours. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <!-- Dalamud provides no audio API, so the plugin opens its own WASAPI render stream. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <!-- Decodes venue banners (WebP) into pixels the drawn channels can paint. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>
