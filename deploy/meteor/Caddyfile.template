# setup.sh fills __DOMAIN__ in and writes the real Caddyfile.
{
	servers :8443 {
		# libvlc 3 cannot fetch HLS over HTTP/2 — it aborts segments with RST_STREAM.
		# This listener exists solely for the player, so it speaks HTTP/1.1 only.
		protocols h1
	}
}

__DOMAIN__ {
	# The party service lives under /party — the plugin joins host and path naively, so
	# "domain/party" typed as the server address is all the routing there is.
	handle_path /party/* {
		# The auth callback is for MediaMTX, which reaches the API directly over the
		# compose network. Nobody outside has any business probing it.
		@auth path /auth
		respond @auth 403

		reverse_proxy party-api:8099
	}

	# Everything else is the website, proxied from GitHub Pages — a git push to docs/
	# updates the site here with nothing to copy onto the box.
	handle {
		rewrite * /Aetherstream{path}
		reverse_proxy https://corkedfever.github.io {
			header_up Host corkedfever.github.io
		}
	}
}

__DOMAIN__:8443 {
	reverse_proxy mediamtx:8888
}
